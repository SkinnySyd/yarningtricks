---
import { siteConfig } from '../site-config';
---
<footer class="site-footer">
  <div class="site-container footer-top">
    <div class="footer-intro">
      <a href="/" class="footer-brand">thread <em>&</em> petal<span>.</span></a>
      <p>Little loops, big joy. A gentle corner of the internet for makers of all levels.</p>
    </div>
    <div class="footer-links">
      <div><h3>Make something</h3><a href="/patterns/">All patterns</a><a href="/learn/">Start learning</a><a href="/blog/">The journal</a></div>
      <div><h3>Good to know</h3><a href="/about/">Our story</a><a href="/privacy/">Privacy policy</a><button type="button" id="tp-cookie-settings" class="tp-footer-cookie-button">Cookie preferences</button><a href={`mailto:${siteConfig.contactEmail}`}>Contact us</a><a href="/rss.xml">RSS feed</a>{siteConfig.pinterestUrl && <a href={siteConfig.pinterestUrl} target="_blank" rel="noopener noreferrer">Pinterest ↗</a>}</div>
    </div>
  </div>
  <div class="site-container footer-bottom"><span>© {new Date().getFullYear()} {siteConfig.name}. Made with yarn & heart.</span><span>Free patterns, forever cozy. ✿</span></div>
</footer>

<style>
  .tp-footer-cookie-button { appearance: none; border: 0; background: transparent; color: inherit; cursor: pointer; font: inherit; text-align: left; padding: 0; text-decoration: underline; text-underline-offset: 2px; }
  .tp-footer-cookie-button:hover { opacity: .75; }
  .tp-footer-cookie-button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
