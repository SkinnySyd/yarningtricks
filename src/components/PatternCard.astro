---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'patterns'>; compact?: boolean }
const { post, compact = false } = Astro.props;
const { title, description, image, imageAlt, difficulty, category, duration } = post.data;
---
<article class:list={['pattern-card', { compact }]} data-filter-card data-category={category.toLowerCase()} data-keywords={`${title} ${description} ${post.data.tags.join(' ')} ${category}`.toLowerCase()}>
  <a class="pattern-thumb-link" href={`/patterns/${post.id}/`} aria-label={`Read ${title}`}>
    <img class="pattern-thumb" src={image} alt={imageAlt} loading="lazy" width="600" height="750" />
    <span class="image-corner" aria-hidden="true">↗</span>
  </a>
  <div class="pattern-meta"><span>{category}</span><span aria-hidden="true">·</span><span>{duration}</span></div>
  <h3><a href={`/patterns/${post.id}/`}>{title}</a></h3>
  <p>{description}</p>
  <div class="pattern-bottom"><span class="difficulty">✳ {difficulty}</span><a href={`/patterns/${post.id}/`} aria-label={`View ${title}`}>Read pattern <span aria-hidden="true">→</span></a></div>
</article>
