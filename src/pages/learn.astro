---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PatternCard from '../components/PatternCard.astro';

const lessons = (await getCollection('lessons', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const patterns = await getCollection('patterns', ({ data }) => !data.draft);

// Use the existing chain tutorial as step 2: don't publish a duplicate competing article.
const chain = patterns.find((p) => p.id === 'first-crochet-chain');
const steps = [
  ...lessons.map((lesson) => ({
    order: lesson.data.order,
    title: lesson.data.title,
    description: lesson.data.description,
    duration: lesson.data.duration,
    focus: lesson.data.focus,
    level: lesson.data.level,
    href: `/learn/${lesson.id}/`,
  })),
  ...(chain ? [{
    order: 2,
    title: chain.data.title,
    description: 'Make your first slip knot and foundation chain with clear, step-by-step instructions.',
    duration: chain.data.duration,
    focus: 'Slip knot & chain',
    level: 'Absolute beginner',
    href: `/patterns/${chain.id}/`,
  }] : []),
].sort((a, b) => a.order - b.order);

const chapters = [
  { id: 'first-stitches', number: '01', label: 'Start here', title: 'Find your first rhythm', summary: 'Your hook, the first stitches, and a comfortable foundation.', start: 0, end: 5, accent: 'peach' },
  { id: 'grow-your-skills', number: '02', label: 'Build confidence', title: 'Make the stitches yours', summary: 'Shaping, reading patterns, fixing mistakes, and working with color.', start: 5, end: 11, accent: 'sage' },
  { id: 'little-details', number: '03', label: 'Make with confidence', title: 'Shape, join & finish', summary: 'Thoughtful finishes, special techniques, and amigurumi construction.', start: 11, end: Infinity, accent: 'lavender' },
];
const groupedLessons = chapters.map(chapter => ({
  ...chapter,
  items: steps.filter(step => step.order >= chapter.start + 1 && step.order <= chapter.end),
}));

const firstProjects = ['simple-yarn-bookmark', 'crochet-flower', 'granny-square-coaster']
  .flatMap((id) => {
    const post = patterns.find((entry) => entry.id === id);
    return post ? [post] : [];
  });
---

<BaseLayout
  title="Learn Crochet from Scratch — Free Beginner Lessons"
  description="Learn to crochet step by step with free lessons on hooks, chains, single crochet, double crochet, magic rings, shaping, US/UK terms and beginner projects."
  image="/images/chain.png"
>
  <section class="school-cover" aria-labelledby="learn-title">
    <div class="site-container school-cover-inner">
      <div class="school-intro">
        <span class="school-overline">THE THREAD & PETAL CROCHET SCHOOL</span>
        <h1 id="learn-title">A little more confidence <em>with every stitch.</em></h1>
        <p>A welcoming place to learn crochet from your first loop to your first handmade friend. Follow the chapters in order, or find the exact skill you need today.</p>
        <div class="school-cover-actions">
          <a href="#lesson-finder" class="btn btn-primary">Explore the lessons <span aria-hidden="true">↓</span></a>
          <a href="#first-projects" class="school-soft-link">I'd rather make something <span aria-hidden="true">↗</span></a>
        </div>
        <div class="school-cover-foot"><span><strong>{steps.length}</strong> practical tutorials</span><span>Free to explore</span><span>Learn at your pace</span></div>
      </div>
      <div class="school-cover-art">
        <div class="school-art-frame">
          <img src="/images/chain.png" alt="Pastel crochet chain illustration with a hook" width="600" height="680" fetchpriority="high" />
          <div class="school-art-caption"><span>01 — THE FIRST LOOP</span><strong>Every beautiful thing starts somewhere.</strong></div>
        </div>
        <span class="school-art-flower" aria-hidden="true">✿</span>
      </div>
    </div>
  </section>

  <section class="school-guide site-container" aria-labelledby="school-guide-title">
    <div class="school-guide-heading">
      <span class="school-overline">CHOOSE YOUR WAY IN</span>
      <h2 id="school-guide-title">Three little chapters. <em>Your own pace.</em></h2>
      <p>These aren't separate courses or locked levels. They're simply a friendly way to find your place.</p>
    </div>
    <nav class="school-chapter-jumps" aria-label="Jump to a learning chapter">
      {groupedLessons.map(chapter => (
        <a href={'#' + chapter.id} class={'school-chapter-jump tone-' + chapter.accent}>
          <span class="school-chapter-numeral">{chapter.number}</span>
          <span class="school-chapter-jump-copy"><small>{chapter.label} · {chapter.items.length} lessons</small><strong>{chapter.title}</strong><span>{chapter.summary}</span></span>
          <span class="school-jump-arrow" aria-hidden="true">↘</span>
        </a>
      ))}
    </nav>
  </section>

  <section id="lesson-finder" class="school-library site-container" aria-labelledby="learning-title">
    <div class="school-library-top">
      <div><span class="school-overline">YOUR LESSON LIBRARY</span><h2 id="learning-title">Find the skill <em>for today.</em></h2><p>Search by a stitch, technique, or problem. Each tutorial gives you something useful to practice.</p></div>
      <a href="/patterns/" class="school-soft-link">Browse crochet patterns <span aria-hidden="true">↗</span></a>
    </div>
    <div class="school-toolbox">
      <label class="school-search-label" for="school-search">Search the lessons</label>
      <div class="school-search-line"><span aria-hidden="true">⌕</span><input id="school-search" type="search" placeholder="Try ‘color’, ‘magic ring’ or ‘joining’…" autocomplete="off" /></div>
      <div class="school-toolbox-bottom">
        <div class="school-level-filters" role="group" aria-label="Filter lessons by experience">
          <button type="button" data-school-filter="all" aria-pressed="true" class="is-active">All lessons</button>
          <button type="button" data-school-filter="Absolute beginner" aria-pressed="false">Just starting</button>
          <button type="button" data-school-filter="Beginner" aria-pressed="false">Beginner</button>
          <button type="button" data-school-filter="Growing confidence" aria-pressed="false">Growing confidence</button>
        </div>
        <p class="school-results-count" role="status" aria-live="polite"><span id="school-visible-count">{steps.length}</span> lessons found</p>
      </div>
    </div>
    <div class="school-chapters">
      {groupedLessons.map(chapter => (
        <section id={chapter.id} class={'school-chapter school-chapter-' + chapter.accent} data-school-chapter aria-labelledby={chapter.id + '-title'}>
          <div class="school-chapter-heading">
            <span class="school-chapter-heading-number">{chapter.number}</span>
            <div><span class="school-overline">{chapter.label}</span><h3 id={chapter.id + '-title'}>{chapter.title}</h3><p>{chapter.summary}</p></div>
            <span class="school-chapter-count">{chapter.items.length} lessons</span>
          </div>
          <div class="school-lesson-list">
            {chapter.items.map(step => (
              <a href={step.href} class="school-lesson" data-school-lesson data-level={step.level} data-search={[step.title,step.description,step.focus,step.level].join(' ').toLowerCase()}>
                <span class="school-lesson-index">{String(step.order).padStart(2,'0')}</span>
                <span class="school-lesson-copy"><span class="school-lesson-eyebrow">{step.focus} <span aria-hidden="true">·</span> {step.duration}</span><strong>{step.title}</strong><span class="school-lesson-description">{step.description}</span></span>
                <span class="school-lesson-end"><span>{step.level}</span><span class="school-read-action">Open lesson <span aria-hidden="true">↗</span></span></span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <div id="school-no-results" class="school-empty" hidden><strong>No stitches found this time.</strong><p>Try another word or show all levels to find your next lesson.</p><button type="button" id="school-reset">Show all lessons</button></div>
  </section>

  <section class="learn-reference" aria-labelledby="learn-reference-title">
    <div class="site-container learn-reference-grid">
      <div class="learn-reference-copy">
        <span class="learn-eyebrow">A LITTLE NOTE FOR MAKERS EVERYWHERE</span>
        <h2 id="learn-reference-title">One stitch, <em>two names.</em></h2>
        <p>Crochet travels the world, and so do its patterns. US and UK terms don't always mean the same stitch. We use <strong>US terms</strong> throughout our lessons and explain the UK name when it changes.</p>
        <a class="learn-text-link" href="/learn/how-to-read-crochet-patterns/">Learn to read patterns <span aria-hidden="true">↗</span></a>
      </div>
      <div class="learn-terms-card">
        <div class="learn-terms-header"><span>US terminology</span><span>UK terminology</span></div>
        <div class="learn-term-row"><strong>Single crochet (sc)</strong><span>Double crochet (dc)</span></div>
        <div class="learn-term-row"><strong>Half double (hdc)</strong><span>Half treble (htr)</span></div>
        <div class="learn-term-row"><strong>Double crochet (dc)</strong><span>Treble (tr)</span></div>
        <p>Same movements, different stitch names. Check which terminology a pattern uses before you begin.</p>
      </div>
    </div>
  </section>

  <section id="first-projects" class="site-container learn-section learn-projects" aria-labelledby="learn-projects-title">
    <div class="learn-section-heading">
      <div><span class="learn-eyebrow">PUT YOUR NEW SKILLS TO WORK</span><h2 id="learn-projects-title">Make something <em>small and lovely.</em></h2><p>Turn a few familiar stitches into a first handmade project. The patterns below are already part of Thread & Petal.</p></div>
      <a class="learn-text-link" href="/patterns/?category=Stitch%20guides">Browse stitch guides <span aria-hidden="true">↗</span></a>
    </div>
    <div class="cards-grid learn-project-grid">{firstProjects.map((post) => <PatternCard post={post} />)}</div>
  </section>

  <section class="site-container learn-faq" aria-labelledby="learn-faq-title">
    <span class="learn-eyebrow">A FEW THINGS YOU MAY BE WONDERING</span>
    <h2 id="learn-faq-title">Questions from the <em>first row.</em></h2>
    <div class="learn-faq-list">
      <details><summary>What should I buy to start crocheting?</summary><p>Try smooth, light-colored medium-weight yarn and a 5 mm hook (US H/8) as a common beginner starting point. A pair of scissors and a yarn needle are useful extras. Follow your yarn label if it recommends another hook size.</p></details>
      <details><summary>Do I have to learn every stitch before starting a project?</summary><p>No. Once you can chain and single crochet, our <a href="/patterns/simple-yarn-bookmark/">Little Loop Yarn Bookmark</a> is a manageable first practice piece. Learn taller stitches or magic rings when a project calls for them.</p></details>
      <details><summary>Why does a pattern say UK double crochet when I learned US single crochet?</summary><p>Those are two names for the same stitch. The terminology differs between pattern conventions. See our <a href="/learn/how-to-read-crochet-patterns/">US/UK conversion guide</a> before following an unfamiliar pattern.</p></details>
      <details><summary>What if I keep making mistakes?</summary><p>Unraveling and trying again is normal. Count the V-shaped stitches at the end of each row and mark the first and last stitches if you lose your place. Our <a href="/learn/fix-crochet-mistakes-and-finish/">troubleshooting lesson</a> walks through common fixes.</p></details>
    </div>
  </section>

  <section class="learn-last-note"><div class="site-container learn-last-inner"><div class="learn-last-ornament" aria-hidden="true">✿</div><div><span class="learn-eyebrow">YOU BELONG HERE</span><h2>There's no rush to get <em>every stitch perfect.</em></h2><p>Take your time, try the next loop, and enjoy the little triumphs. Makers everywhere began with a first stitch.</p></div><a class="btn btn-primary" href="/patterns/">Explore free patterns <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>

