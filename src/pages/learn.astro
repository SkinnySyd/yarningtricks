.school-chapter-jump-copy strong{font:500 24px/1.22 Georgia,serif}
.school-chapter-jump-copy>span{font-size:12px;color:#6b6263;line-height:1.6}
.school-jump-arrow{position:absolute;bottom:19px;right:20px;color:#85546a}
.school-library{padding-bottom:95px;scroll-margin-top:22px}
.school-library-top{display:flex;justify-content:space-between;gap:28px;align-items:end;margin-bottom:30px}
.school-toolbox{background:#fffdf9;border:1px solid #ddd8d0;border-radius:18px;padding:25px;margin-bottom:36px;box-shadow:0 5px 18px #60443d0a}
.school-search-label{font-size:12px;font-weight:800;color:#584e4b;display:block;margin-bottom:10px}
.school-search-line{position:relative;max-width:780px}
.school-search-line>span{position:absolute;top:50%;left:15px;transform:translateY(-50%);font-size:25px;color:#765d6d;pointer-events:none}
.school-search-line input{width:100%;border:1px solid #c9bab6;border-radius:12px;padding:15px 16px 15px 48px;background:#fff;min-height:52px;color:#443638;font-size:14px}
.school-toolbox-bottom{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:21px;flex-wrap:wrap}
.school-level-filters{display:flex;flex-wrap:wrap;gap:8px}
.school-level-filters button{cursor:pointer;background:#f5f0e8;border:1px solid #d9cfc6;border-radius:999px;color:#604f52;font-size:12px;font-weight:700;padding:11px 16px;min-height:44px}
.school-level-filters button:hover{border-color:#8d687b}
.school-level-filters button.is-active{background:#63556b;color:#fff;border-color:#63556b}
.school-results-count{margin:0;color:#695d62;font-size:12px;font-weight:700}
.school-chapters{display:grid;gap:40px}
.school-chapter{scroll-margin-top:25px;border-radius:21px;overflow:hidden;border:1px solid #e5ddd3}
.school-chapter-heading{display:flex;align-items:center;gap:22px;padding:28px 31px;background:#f7eee8}
.school-chapter-sage .school-chapter-heading{background:#edf1e8}.school-chapter-lavender .school-chapter-heading{background:#f3edf4}
.school-chapter-heading-number{font:italic 43px Georgia,serif;color:#926b77}
.school-chapter-heading h3{font:500 clamp(25px,3vw,36px)/1.16 Georgia,serif;margin:8px 0}
.school-chapter-heading p{margin:0;color:#6e6463;font-size:13px;line-height:1.6}
.school-chapter-count{margin-left:auto;white-space:nowrap;font-size:11px;color:#695b65;font-weight:750}
.school-lesson-list{background:#fffdf9}
.school-lesson{display:grid;grid-template-columns:50px minmax(0,1fr) minmax(110px,.24fr);align-items:center;gap:20px;padding:23px 30px;min-height:125px;border-top:1px solid #e8dfd8;transition:background .2s}
.school-lesson:hover{background:#f7f3ed}
.school-lesson-index{font:italic 25px Georgia,serif;color:#9b8790;align-self:start}
.school-lesson-copy{display:flex;flex-direction:column;gap:8px;min-width:0}
.school-lesson-eyebrow{font-size:10px;letter-spacing:.075em;text-transform:uppercase;font-weight:750;color:#7b6570}
.school-lesson-copy strong{font:500 clamp(21px,2.25vw,27px)/1.19 Georgia,serif;letter-spacing:-.03em;color:#3f3438}
.school-lesson-description{font-size:12px;color:#776e6a;line-height:1.7}
.school-lesson-end{display:flex;flex-direction:column;align-items:flex-end;gap:16px;text-align:right;font-size:11px;color:#6a5e66}
.school-read-action{font-weight:800;color:#775068}
.school-empty{text-align:center;background:#f2eee7;border-radius:18px;padding:35px;color:#4f4248}
.school-empty strong{font:500 25px Georgia,serif}.school-empty p{margin:12px 0 20px;font-size:13px}
.school-empty button{background:#63556b;color:#fff;border-radius:999px;border:0;padding:12px 18px;cursor:pointer}
@media(max-width:900px){.school-cover-inner{grid-template-columns:1fr;gap:35px}.school-cover-art{max-width:400px}.school-chapter-jumps{grid-template-columns:1fr}.school-chapter-jump{min-height:140px}.school-chapter-jump-copy>span{max-width:560px}}
@media(max-width:650px){.school-cover-inner{padding-block:49px 62px}.school-intro h1{font-size:clamp(43px,11vw,62px)}.school-cover-foot{gap:9px 17px}.school-cover-foot span+span:before{margin-right:12px}.school-cover-art{max-width:310px}.school-art-flower{font-size:48px;right:0}.school-guide{padding-block:58px}.school-library{padding-bottom:65px}.school-library-top{align-items:flex-start;flex-direction:column}.school-chapter-heading{padding:22px 17px;gap:13px;align-items:flex-start}.school-chapter-heading-number{font-size:31px}.school-chapter-count{display:none}.school-lesson{grid-template-columns:32px minmax(0,1fr);gap:9px 12px;padding:21px 15px}.school-lesson-end{grid-column:2;flex-direction:row;align-items:center;justify-content:space-between;text-align:left;gap:10px}.school-lesson-index{font-size:23px}.school-lesson-copy strong{font-size:22px}.school-toolbox{padding:18px}.school-level-filters button{padding:10px 12px}}
@media(prefers-reduced-motion:reduce){.school-chapter-jump,.school-lesson{transition:none}}
</style>
<script>
  const searchInput = document.querySelector<HTMLInputElement>('#school-search');
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-school-filter]'));
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-school-chapter]'));
  const lessonLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-school-lesson]'));
  const count = document.querySelector<HTMLElement>('#school-visible-count');
  const empty = document.querySelector<HTMLElement>('#school-no-results');
  const query = new URLSearchParams(window.location.search);
  const choices = ['all', 'Absolute beginner', 'Beginner', 'Growing confidence'];
  let level = choices.includes(query.get('level') || '') ? query.get('level')! : 'all';
  if (searchInput) searchInput.value = query.get('q') || '';
  function filterLessons() {
    const term = (searchInput?.value || '').toLocaleLowerCase().trim();
    let visible = 0;
    for (const lesson of lessonLinks) {
      const matches = (level === 'all' || lesson.dataset.level === level) && (!term || (lesson.dataset.search || '').includes(term));
      lesson.hidden = !matches;
      if (matches) visible++;
    }
    for (const chapter of chapters) chapter.hidden = !chapter.querySelector('[data-school-lesson]:not([hidden])');
    for (const button of filterButtons) {
      const active = button.dataset.schoolFilter === level;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    }
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible > 0;
    const url = new URL(window.location.href);
    if (term) url.searchParams.set('q', searchInput?.value.trim() || '');
    else url.searchParams.delete('q');
    if (level !== 'all') url.searchParams.set('level', level);
    else url.searchParams.delete('level');
    window.history.replaceState(null,'',url.pathname + url.search + url.hash);
  }
  filterButtons.forEach(button => button.addEventListener('click', () => { level = button.dataset.schoolFilter || 'all'; filterLessons(); }));
  searchInput?.addEventListener('input',filterLessons);
  document.querySelector('#school-reset')?.addEventListener('click',() => {level='all'; if(searchInput) searchInput.value=''; filterLessons(); searchInput?.focus();});
  filterLessons();
</script>
