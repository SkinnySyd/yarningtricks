---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Everything on this page comes from published patterns in the existing collection.
// Curated order is intentional; missing or draft entries are skipped automatically.
const posts = (await getCollection('patterns', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const findPosts = (ids: string[]) => ids.flatMap((id) => {
  const post = posts.find((entry) => entry.id === id);
  return post ? [post] : [];
});

// Use the site's finished-project imagery in preference to decorative cover art.
// These files already exist in public/images/; no additional assets are required.
const finishedPhotos: Record<string, { src: string; alt: string }> = {
  'koala-bottle-buddy': {
    src: '/images/finished-projects/koala-bottle-buddy.webp',
    alt: 'Blue and cream crocheted koala holding a bottle with a little eucalyptus leaf charm',
  },
  'sunflower-flower-pen': {
    src: '/images/finished-projects/sunflower-flower-pen.webp',
    alt: 'Yellow crocheted sunflower rising from a smiling pink flowerpot',
  },
  'rose-flower-pen': {
    src: '/images/finished-projects/rose-flower-pen.webp',
    alt: 'Red crocheted rose with green leaves in a small smiling cream flowerpot',
  },
  'crocus-flower-pen': {
    src: '/images/finished-projects/crocus-flower-pen.webp',
    alt: 'Purple crocheted crocus flower growing from a lavender smiling flowerpot',
  },
  'hibiscus-flower-pen': {
    src: '/images/finished-projects/hibiscus-flower-pen.webp',
    alt: 'Pink crocheted hibiscus with a yellow center in a mint-green smiling flowerpot',
  },
  'octopus-potpourri-pal': {
    src: '/images/finished-projects/octopus-potpourri-pal.webp',
    alt: 'Finished pink crocheted octopus amigurumi with eight little arms and a smiling face',
  },
};

const pictureFor = (post: (typeof posts)[number]) => finishedPhotos[post.id] ?? {
  src: post.data.heroImage ?? post.data.image,
  alt: post.data.heroImageAlt ?? post.data.imageAlt,
};

const heroPicks = findPosts(['koala-bottle-buddy', 'sunflower-flower-pen', 'rose-flower-pen']);
const [heroMain, heroFlower, heroRose] = heroPicks;
const featured = findPosts([
  'crochet-poppet-doll',
  'sunflower-flower-pen',
  'koala-bottle-buddy',
  'rose-flower-pen',
  'octopus-potpourri-pal',
  'crocus-flower-pen',
]);
const displayPicks = featured.length ? featured : posts.slice(0, 6);
const flowerPicks = findPosts([
  'sunflower-flower-pen',
  'rose-flower-pen',
  'crocus-flower-pen',
  'hibiscus-flower-pen',
]);

const categories = [
  {
    name: 'Amigurumi',
    detail: 'Little characters, big personalities',
    image: '/images/finished-projects/koala-bottle-buddy.webp',
    alt: 'Finished blue crocheted koala amigurumi',
    tint: 'sage',
  },
  {
    name: 'Accessories',
    detail: 'Thoughtful, useful little makes',
    image: '/images/tutorials/pumpkin-halloween-bag/bag-with-candy.webp',
    alt: 'Handmade orange crochet pumpkin candy bag',
    tint: 'peach',
  },
  {
    name: 'Home & decor',
    detail: 'A handmade touch for your space',
    image: '/images/granny-square.png',
    alt: 'Illustrated pink and cream crochet granny square',
    tint: 'lilac',
  },
  {
    name: 'Stitch guides',
    detail: 'Start small, grow your skills',
    image: '/images/chain.png',
    alt: 'Illustration of crochet chain stitches',
    tint: 'butter',
  },
].map((category) => ({
  ...category,
  count: posts.filter((post) => post.data.category === category.name).length,
  href: `/patterns/?category=${encodeURIComponent(category.name)}`,
}));
---

<BaseLayout
  title="Thread & Petal"
  description="Find free crochet patterns, amigurumi friends, flower pens and beginner-friendly stitch guides at Thread & Petal. A welcoming crochet corner for makers everywhere."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="site-container home-hero-grid">
      <div class="home-hero-copy">
        <span class="home-eyebrow"><span aria-hidden="true">✿</span> WELCOME TO THREAD & PETAL</span>
        <h1 id="home-title">A little yarn.<br />A lot of <em>lovely.</em></h1>
        <p class="home-hero-lede">A cozy place to discover free crochet patterns, playful amigurumi, happy little flowers, and the joy of making something by hand.</p>
        <div class="home-hero-actions">
          <a class="btn btn-primary" href="/patterns/">Explore free patterns <span aria-hidden="true">↗</span></a>
          <a class="home-text-link" href="/learn/">New to crochet? Start here <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-welcome-note">
          <span class="home-note-flower" aria-hidden="true">✳</span>
          <span><strong>For every kind of maker.</strong><br />From first-time stitches to wonderfully ambitious projects.</span>
        </div>
      </div>

      {heroMain && heroFlower && heroRose && (
        <div class="home-hero-gallery" aria-label="Featured crochet projects">
          <span class="home-gallery-spark home-spark-one" aria-hidden="true">✳</span>
          <span class="home-gallery-spark home-spark-two" aria-hidden="true">✦</span>
          <a class="home-hero-photo home-hero-main" href={`/patterns/${heroMain.id}/`} aria-label={`Explore ${heroMain.data.title}`}>
            <img src={pictureFor(heroMain).src} alt={pictureFor(heroMain).alt} width="664" height="860" decoding="async" fetchpriority="high" />
            <span class="home-photo-tag">Meet the little makers <span aria-hidden="true">↗</span></span>
          </a>
          <a class="home-hero-photo home-hero-mini home-hero-sunflower" href={`/patterns/${heroFlower.id}/`} aria-label={`Explore ${heroFlower.data.title}`}>
            <img src={pictureFor(heroFlower).src} alt={pictureFor(heroFlower).alt} width="256" height="457" decoding="async" />
          </a>
          <a class="home-hero-photo home-hero-mini home-hero-rose" href={`/patterns/${heroRose.id}/`} aria-label={`Explore ${heroRose.data.title}`}>
            <img src={pictureFor(heroRose).src} alt={pictureFor(heroRose).alt} width="338" height="400" decoding="async" />
          </a>
          <span class="home-gallery-seal" aria-hidden="true">made with<br /><em>heart</em><span>♡</span></span>
        </div>
      )}
    </div>
  </section>

  <div class="home-ribbon" aria-label="What you'll find at Thread and Petal">
    <div class="site-container home-ribbon-inner">
      <span>✿ Free crochet patterns</span>
      <span>♡ A welcoming space to learn</span>
      <span>✳ Little projects, big joy</span>
    </div>
  </div>

  <section class="site-container home-section home-featured" aria-labelledby="home-featured-title">
    <div class="home-section-heading">
      <div>
        <span class="home-eyebrow">THE PATTERN BASKET</span>
        <h2 id="home-featured-title">A few things you'll <em>love to make.</em></h2>
        <p>Soft little friends, blooms that never wilt, and projects full of personality. Find a favorite and get stitching.</p>
      </div>
      <a class="home-text-link home-heading-link" href="/patterns/">Browse all {posts.length} patterns <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-project-grid">
      {displayPicks.map((post) => (
        <article class="home-project-card">
          <a class="home-project-image" href={`/patterns/${post.id}/`} aria-label={`View ${post.data.title}`}>
            <img src={pictureFor(post).src} alt={pictureFor(post).alt} loading="lazy" decoding="async" width="600" height="750" />
            <span class="home-image-arrow" aria-hidden="true">↗</span>
          </a>
          <div class="home-project-meta"><span>{post.data.category}</span><span aria-hidden="true">·</span><span>{post.data.difficulty}</span></div>
          <h3><a href={`/patterns/${post.id}/`}>{post.data.title}</a></h3>
          <div class="home-project-footer"><span>{post.data.duration}</span><a href={`/patterns/${post.id}/`}>Free pattern <span aria-hidden="true">→</span></a></div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-categories" aria-labelledby="home-categories-title">
    <div class="site-container">
      <div class="home-section-heading home-category-heading">
        <div>
          <span class="home-eyebrow">FOLLOW YOUR CURIOSITY</span>
          <h2 id="home-categories-title">What's in your <em>making mood?</em></h2>
          <p>Browse by the kinds of projects you love — or discover something completely new.</p>
        </div>
      </div>
      <div class="home-category-grid">
        {categories.map((category) => (
          <a class={`home-category-card home-category-${category.tint}`} href={category.href}>
            <span class="home-category-image"><img src={category.image} alt={category.alt} loading="lazy" decoding="async" width="360" height="390" /></span>
            <span class="home-category-content">
              <span class="home-category-count">{category.count} {category.count === 1 ? 'project' : 'projects'}</span>
              <strong>{category.name}</strong>
              <span class="home-category-description">{category.detail}</span>
              <span class="home-category-arrow" aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="site-container home-section home-flower-section" aria-labelledby="home-flowers-title">
    <div class="home-flower-copy">
      <span class="home-eyebrow">A LITTLE GARDEN IN YARN</span>
      <h2 id="home-flowers-title">Flowers that <em>stay forever.</em></h2>
      <p>Sunflowers, roses, crocuses, and hibiscus blooms — our crochet flower pens bring a little cheer to desks, gifts, and quiet afternoons.</p>
      <p class="home-flower-note">Each flower has its own pattern, with the skill level and supplies listed before you begin.</p>
      <a class="btn btn-primary" href="/patterns/sunflower-flower-pen/">Make a sunflower <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-flower-grid" aria-label="Crochet flower pen patterns">
      {flowerPicks.map((post) => (
        <a href={`/patterns/${post.id}/`} class="home-flower-card" aria-label={`Read ${post.data.title}`}>
          <img src={pictureFor(post).src} alt={pictureFor(post).alt} loading="lazy" decoding="async" width="350" height="420" />
          <span>{post.id.startsWith('sunflower') ? 'Sunflower' : post.id.startsWith('rose') ? 'Rose' : post.id.startsWith('crocus') ? 'Crocus' : 'Hibiscus'} <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-learn" aria-labelledby="home-learn-title">
    <div class="site-container home-learn-grid">
      <div class="home-learn-intro">
        <span class="home-eyebrow">YOUR FIRST STITCH IS A BIG DEAL</span>
        <h2 id="home-learn-title">Never crocheted before? <em>You're in the right place.</em></h2>
        <p>You don't need fancy supplies or years of practice to get started. Just a hook, some yarn, and the curiosity to try.</p>
        <a class="btn btn-light" href="/learn/">Take your first steps <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-learn-steps">
        <div class="home-learn-step"><span class="home-step-number">01</span><div><h3>Gather your tools</h3><p>Learn what you really need for your first crochet project.</p></div></div>
        <div class="home-learn-step"><span class="home-step-number">02</span><div><h3>Get comfortable with the basics</h3><p>Begin with a slip knot and chain, then build your confidence.</p></div></div>
        <div class="home-learn-step"><span class="home-step-number">03</span><div><h3>Make a little something</h3><p>Choose a small project and celebrate every stitch.</p></div></div>
      </div>
    </div>
  </section>

  <section class="site-container home-last-note" aria-labelledby="home-note-title">
    <div class="home-note-flourish" aria-hidden="true">✿</div>
    <span class="home-eyebrow">A CORNER FOR MAKERS EVERYWHERE</span>
    <h2 id="home-note-title">Different places. Different yarns.<br /><em>The same little joy of making.</em></h2>
    <p>Thread & Petal is an independently run crochet blog for curious hands around the world. Whether you're here to learn, find a handmade gift idea, or try something adventurous, you're always welcome.</p>
    <div class="home-note-actions">
      <a class="home-text-link" href="/about/">Get to know Thread & Petal <span aria-hidden="true">↗</span></a>
      <a class="home-text-link" href="/blog/">Explore the crochet journal <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { background: radial-gradient(circle at 74% 32%, #f7e2da 0, transparent 34%), linear-gradient(138deg, #fffaf4 30%, #fff0e9 100%); overflow: hidden; }
  .home-hero-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); align-items: center; gap: clamp(32px, 6vw, 85px); padding-block: 92px 96px; }
  .home-eyebrow { color: #9b6174; font-size: 11px; letter-spacing: .16em; font-weight: 800; line-height: 1.5; }
  .home-eyebrow > span { font-size: 20px; margin-right: 7px; vertical-align: -1px; }
  .home-hero-copy h1 { font-size: clamp(57px, 6.1vw, 89px); line-height: 1.055; letter-spacing: -.075em; margin: 23px 0 25px; }
  .home-hero-copy h1 em { color: #a25e78; letter-spacing: -.07em; }
  .home-hero-lede { color: var(--muted); font-size: clamp(15px, 1.32vw, 17px); line-height: 1.9; max-width: 455px; }
  .home-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 30px; }
  .home-text-link { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 750; line-height: 1.4; color: #855068; text-underline-offset: 5px; }
  .home-text-link:hover, .home-text-link:focus-visible { text-decoration: underline; }
  .home-welcome-note { display: flex; align-items: center; gap: 14px; color: #7f6f6e; font-size: 12px; line-height: 1.7; margin-top: 52px; }
  .home-welcome-note strong { color: #5c4a4d; }
  .home-note-flower { color: #b88a8b; font-size: 43px; line-height: 1; }
  .home-hero-gallery { position: relative; display: grid; min-height: 565px; grid-template-columns: minmax(0, 1.35fr) minmax(0, .85fr); grid-template-rows: 1fr 1fr; gap: 16px; padding: 20px 16px 22px 0; isolation: isolate; }
  .home-hero-gallery::before { content: ''; position: absolute; inset: 0 1px 0 12%; border-radius: 53% 48% 26% 30%; background: #edd5cb; transform: rotate(-5deg); z-index: -1; }
  .home-hero-photo { position: relative; display: block; border: 7px solid #fffdf8; overflow: hidden; background: #f4e4de; box-shadow: 0 14px 28px #795c5021; }
  .home-hero-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .home-hero-photo:hover img { transform: scale(1.035); }
  .home-hero-main { grid-row: span 2; border-radius: 185px 185px 30px 30px; transform: rotate(-3deg); }
  .home-hero-main img { object-position: center; }
  .home-hero-mini { border-radius: 130px 130px 25px 25px; }
  .home-hero-sunflower { transform: rotate(5deg); }
  .home-hero-rose { transform: rotate(-4deg); }
  .home-photo-tag { position: absolute; bottom: 19px; left: 50%; width: max-content; max-width: calc(100% - 24px); transform: translateX(-50%); padding: 12px 16px; background: #fff9f0ef; color: #6c4b54; font-size: 12px; font-weight: 750; border-radius: 40px; box-shadow: 0 4px 14px #23151419; text-align: center; }
  .home-photo-tag span { margin-left: 4px; }
  .home-gallery-spark { position: absolute; z-index: 3; color: #a86a83; pointer-events: none; }
  .home-spark-one { font-size: 46px; top: 34px; left: -37px; }
  .home-spark-two { font-size: 45px; bottom: 14px; right: -19px; }
  .home-gallery-seal { position: absolute; z-index: 3; right: 19%; bottom: -23px; width: 112px; height: 112px; border: 7px solid #fff9f1; border-radius: 50%; background: #e1e9d4; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #667356; font: italic 15px/1.2 Georgia, serif; transform: rotate(10deg); pointer-events: none; }
  .home-gallery-seal em { color: #855a6a; }
  .home-gallery-seal span { font: 20px sans-serif; margin-top: 3px; }
  .home-ribbon { border-block: 1px solid #eadbd3; background: #f8ebe5; }
  .home-ribbon-inner { padding-block: 21px; display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; gap: 14px 25px; color: #996c7a; font-size: 12px; font-weight: 700; letter-spacing: .035em; }
  .home-section { padding-top: 100px; padding-bottom: 103px; }
  .home-section-heading { display: flex; justify-content: space-between; align-items: end; gap: 26px; margin-bottom: 35px; }
  .home-section-heading h2, .home-flower-copy h2, .home-learn-intro h2, .home-last-note h2 { font-size: clamp(37px, 4.2vw, 56px); line-height: 1.15; letter-spacing: -.06em; margin: 13px 0 13px; }
  .home-section-heading h2 em, .home-flower-copy h2 em, .home-last-note h2 em { color: var(--berry); }
  .home-section-heading p { color: var(--muted); font-size: 14px; line-height: 1.8; margin: 0; max-width: 640px; }
  .home-heading-link { flex-shrink: 0; margin-bottom: 8px; }
  .home-project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px 27px; }
  .home-project-card { min-width: 0; }
  .home-project-image { position: relative; display: block; overflow: hidden; border-radius: 18px; background: #f1e2db; }
  .home-project-image img { width: 100%; aspect-ratio: 4 / 4.6; object-fit: cover; transition: transform .4s ease; }
  .home-project-image:hover img { transform: scale(1.05); }
  .home-image-arrow { display: grid; place-items: center; position: absolute; top: 14px; right: 14px; background: #fffaf1e8; width: 38px; height: 38px; border-radius: 50%; font-size: 17px; color: #87536a; }
  .home-project-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 17px; color: #9d6a7e; text-transform: uppercase; font-size: 10px; letter-spacing: .1em; font-weight: 800; }
  .home-project-card h3 { font: 500 clamp(21px, 2vw, 26px)/1.3 Georgia, 'Times New Roman', serif; letter-spacing: -.035em; margin: 11px 0 16px; }
  .home-project-card h3 a:hover { color: var(--berry); }
  .home-project-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid #eadfd6; padding-top: 13px; font-size: 12px; }
  .home-project-footer > span { color: #867776; }
  .home-project-footer a { color: var(--berry); font-weight: 750; white-space: nowrap; }
  .home-project-footer a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .home-categories { background: #f8f1eb; padding-block: 90px 95px; }
  .home-category-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 18px; }
  .home-category-card { display: flex; flex-direction: column; overflow: hidden; border-radius: 20px; min-width: 0; background: #edf0e8; transition: transform .25s, box-shadow .25s; }
  .home-category-card:hover { transform: translateY(-4px); box-shadow: 0 13px 30px #6650471a; }
  .home-category-sage { background: #e5ede3; }
  .home-category-peach { background: #f5e2d6; }
  .home-category-lilac { background: #eee7ef; }
  .home-category-butter { background: #f3ecd6; }
  .home-category-image { padding: 14px 14px 0; height: 210px; display: block; overflow: hidden; }
  .home-category-image img { width: 100%; height: 100%; object-fit: cover; border-radius: 12px 12px 0 0; }
  .home-category-content { padding: 23px 22px 24px; display: flex; flex-direction: column; min-height: 172px; position: relative; }
  .home-category-count { font-size: 10px; text-transform: uppercase; font-weight: 800; letter-spacing: .12em; color: #997b7a; }
  .home-category-content strong { font: 500 27px/1.2 Georgia, serif; letter-spacing: -.035em; margin-top: 12px; color: #473b3e; }
  .home-category-description { color: #716567; font-size: 12px; line-height: 1.6; margin-top: 8px; padding-right: 12px; }
  .home-category-arrow { position: absolute; right: 17px; bottom: 14px; color: #945a70; font-size: 22px; }
  .home-flower-section { display: grid; grid-template-columns: minmax(280px, .8fr) minmax(0, 1.2fr); gap: clamp(36px, 6vw, 95px); align-items: center; }
  .home-flower-copy h2 { margin: 19px 0; }
  .home-flower-copy > p { color: var(--muted); font-size: 15px; line-height: 1.9; }
  .home-flower-copy .home-flower-note { color: #8b6a72; font-size: 13px; }
  .home-flower-copy .btn { margin-top: 12px; }
  .home-flower-grid { display: grid; grid-template-columns: repeat(2,minmax(0, 1fr)); gap: 17px; }
  .home-flower-card { display: block; overflow: hidden; border-radius: 16px; background: #f8eae4; position: relative; }
  .home-flower-card img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; transition: transform .35s; }
  .home-flower-card:hover img { transform: scale(1.045); }
  .home-flower-card > span { position: absolute; left: 13px; bottom: 13px; display: flex; justify-content: space-between; align-items: center; min-width: 90px; gap: 15px; border-radius: 50px; padding: 8px 13px; color: #704653; background: #fffaf2ec; font-size: 12px; font-weight: 750; }
  .home-learn { background: #8c5269; color: #fff9f4; padding-block: 84px; }
  .home-learn-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: clamp(50px, 8vw, 112px); align-items: center; }
  .home-learn .home-eyebrow { color: #f0d6dd; }
  .home-learn-intro h2 em { color: #fff0dd; }
  .home-learn-intro > p { max-width: 520px; color: #fae8ed; line-height: 1.85; font-size: 15px; }
  .home-learn-intro .btn { margin-top: 17px; }
  .home-learn-steps { border-top: 1px solid #ffffff55; }
  .home-learn-step { display: grid; grid-template-columns: 58px 1fr; gap: 16px; border-bottom: 1px solid #ffffff55; padding: 21px 0; }
  .home-step-number { font: italic 32px Georgia, serif; color: #e7bac7; }
  .home-learn-step h3 { font: 500 23px/1.25 Georgia, serif; margin: 1px 0 7px; letter-spacing: -.035em; }
  .home-learn-step p { font-size: 13px; color: #f5dde4; line-height: 1.7; margin: 0; }
  .home-last-note { padding-top: 96px; padding-bottom: 110px; text-align: center; }
  .home-note-flourish { font-size: 53px; line-height: 1; color: #b78490; margin-bottom: 14px; }
  .home-last-note h2 { margin: 14px auto 20px; max-width: 900px; }
  .home-last-note p { max-width: 660px; margin: 0 auto 22px; font-size: 15px; color: var(--muted); line-height: 1.9; }
  .home-note-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 18px 35px; }
  @media (max-width: 1050px) {
    .home-hero-grid { gap: 30px; }
    .home-hero-copy h1 { font-size: clamp(52px, 6vw, 72px); }
