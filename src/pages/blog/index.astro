---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) =>
    Number(b.data.featured) - Number(a.data.featured)
    || b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
    || b.data.order - a.data.order
  );

const topics = [
  { name: 'Starting stitches', caption: 'Tools, yarn & first steps', mark: '01', short: 'Starting out' },
  { name: 'The little details', caption: 'Fixes, shaping & finishing', mark: '02', short: 'The little details' },
  { name: 'Flowers & gifts', caption: 'Pretty things worth making', mark: '03', short: 'Flowers & gifts' },
  { name: 'Making moments', caption: 'Ideas from the making table', mark: '04', short: 'Making moments' },
];

const spotlight = articles.find(article => article.data.featured) ?? articles[0];
const recentNotes = articles.filter(article => article.id !== spotlight?.id).slice(0, 3);
const allArticles = spotlight ? articles.filter(article => article.id !== spotlight.id) : articles;
const dateLabel = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title="The Journal — Little Crochet Secrets & Making Notes"
  description="A cozy crochet notebook from Thread & Petal. Explore original stitch tips, amigurumi fixes, finishing advice, flower ideas and thoughtful making notes."
>
  <header class="notebook-cover" aria-labelledby="journal-title">
    <div class="site-container notebook-cover-inner">
      <div>
        <span class="notebook-overline">THREAD & PETAL / THE JOURNAL</span>
        <h1 id="journal-title">Notes from <em>the making table.</em></h1>
        <p>A thoughtful little notebook of crochet discoveries, helpful answers, and inspiration to take back to your hook. Come with a question. Leave with an idea.</p>
        <div class="notebook-cover-actions"><a class="btn btn-primary" href="#journal-notes">Explore the notebook <span aria-hidden="true">↓</span></a><a href="/learn/" class="notebook-text-link">Need a step-by-step lesson? <span aria-hidden="true">↗</span></a></div>
        <div class="notebook-cover-facts"><span>{articles.length} articles to explore</span><span>Tips, ideas & little fixes</span></div>
      </div>
      <div class="notebook-cover-paper" aria-hidden="true"><span class="paper-asterisk">✿</span><span class="paper-edition">THE MAKING TABLE · NOTES NO. 01</span><span class="paper-lines"><i></i><i></i><i></i></span><strong>Every stitch<br />has a story.</strong><span class="paper-footer">a notebook for curious hands ♡</span></div>
    </div>
  </header>

  <section class="site-container notebook-spotlight" aria-labelledby="notebook-spotlight-title">
    <div class="notebook-section-heading"><div><span class="notebook-overline">START WITH A GOOD READ</span><h2 id="notebook-spotlight-title">A note worth <em>opening.</em></h2></div><a href="#journal-notes" class="notebook-text-link">Browse every article <span aria-hidden="true">↘</span></a></div>
    <div class="notebook-feature-grid">
      {spotlight && <a class="notebook-feature-story" href={'/blog/' + spotlight.id + '/'}>
        <span class="feature-story-header"><span>EDITOR'S PICK · {spotlight.data.category}</span><span>{spotlight.data.readTime}</span></span>
        <span class="feature-story-ornament" aria-hidden="true">✳</span>
        <h3>{spotlight.data.title}</h3><p>{spotlight.data.description}</p>
        <span class="feature-story-footer">Read this article <span aria-hidden="true">↗</span></span>
      </a>}
      <div class="notebook-feature-aside"><span class="notebook-overline">MORE FROM THE NOTEBOOK</span>
        {recentNotes.map((article, index) => <a href={'/blog/' + article.id + '/'} class="notebook-aside-link"><span class="notebook-aside-index">{String(index + 1).padStart(2, '0')}</span><span><small>{article.data.category} · {article.data.readTime}</small><strong>{article.data.title}</strong></span><span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>

  <section class="notebook-topics" aria-labelledby="notebook-topics-title"><div class="site-container">
    <div class="notebook-section-heading"><div><span class="notebook-overline">FIND YOUR WAY THROUGH THE PAGES</span><h2 id="notebook-topics-title">What are you <em>curious about?</em></h2><p>Choose a topic and the notebook will show you just those articles.</p></div></div>
    <div class="notebook-topic-grid">
      {topics.map(topic => <a class="notebook-topic-tile" href={'/blog/?topic=' + encodeURIComponent(topic.name) + '#journal-notes'}><span class="notebook-topic-number">{topic.mark}</span><strong>{topic.short}</strong><span>{topic.caption}</span><small>{articles.filter(article=>article.data.category===topic.name).length} notes <span aria-hidden="true">↘</span></small></a>)}
    </div>
  </div></section>

  <section class="site-container notebook-library" id="journal-notes" aria-labelledby="journal-notes-title">
    <div class="notebook-section-heading"><div><span class="notebook-overline">THE COMPLETE NOTEBOOK</span><h2 id="journal-notes-title">Turn to the <em>right page.</em></h2><p>Search for a question, choose a topic, or browse the whole collection.</p></div></div>
    <div class="notebook-discovery">
      <label class="notebook-search-label" for="journal-search">Search the Journal</label>
      <div class="notebook-search-row"><span class="notebook-search-icon" aria-hidden="true">⌕</span><input type="search" id="journal-search" placeholder="Try ‘stuffing’, ‘yarn’, ‘flowers’ or ‘shaping’…" autocomplete="off" /></div>
      <div class="notebook-filter-row">
        <div class="notebook-filter-set" role="group" aria-label="Filter Journal by topic">
          <button type="button" data-journal-filter="" class="is-active" aria-pressed="true">All topics</button>
          {topics.map(topic => <button type="button" data-journal-filter={topic.name} aria-pressed="false">{topic.short}</button>)}
        </div>
        <p role="status" aria-live="polite" class="notebook-visible-count"><span id="journal-visible-count">{articles.length}</span> articles found</p>
      </div>
    </div>
    <div class="notebook-article-list" id="journal-story-list">
      {articles.map((article, index) => <article class="notebook-article" data-journal-story data-topic={article.data.category} data-search={[article.data.title, article.data.description, article.data.category].join(' ').toLowerCase()}>
        <a href={'/blog/' + article.id + '/'} class="notebook-article-link">
          <span class="notebook-article-index">{String(index + 1).padStart(2,'0')}</span>
          <span class="notebook-article-body"><span class="notebook-article-meta">{article.data.category} <span aria-hidden="true">·</span> {article.data.readTime}</span><strong>{article.data.title}</strong><span class="notebook-article-excerpt">{article.data.description}</span></span>
          <span class="notebook-article-end"><time datetime={article.data.publishedDate.toISOString().slice(0,10)}>{dateLabel(article.data.publishedDate)}</time><span class="notebook-article-action">Read article <span aria-hidden="true">↗</span></span></span>
        </a>
      </article>)}
    </div>
    {articles.length === 0 && <p class="journal-empty">Our notebook is just getting started. Visit the crochet school for some practical lessons.</p>}
    <div class="notebook-empty" id="journal-no-results" hidden><strong>No matching notes just yet.</strong><p>Try a different word or show all topics.</p><button type="button" id="journal-reset">Show all articles</button></div>
  </section>

  <section class="journal-make-invitation" aria-labelledby="journal-make-title">
    <div class="site-container journal-make-inner">
      <div class="journal-make-ornament" aria-hidden="true"><span>✿</span><span>✳</span></div>
      <div class="journal-make-copy">
        <span class="eyebrow">FROM NOTEBOOK TO MAKING TABLE</span>
        <h2 id="journal-make-title">Know the little trick? <em>Now make the lovely thing.</em></h2>
        <p>The Journal holds the ideas and small secrets. Our Free Patterns basket has the complete step-by-step projects, ready for your hook.</p>
      </div>
      <a class="btn btn-primary" href="/patterns/">Explore free patterns <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="site-container journal-learn-invitation" aria-labelledby="journal-learn-title">
    <span class="eyebrow">NEW TO THE HOOK?</span>
    <h2 id="journal-learn-title">Every maker starts <em>somewhere.</em></h2>
    <p>If the stitches themselves feel new, the crochet school offers a gentle learning path, one loop at a time.</p>
    <a class="journal-text-link" href="/learn/">Visit the crochet school <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#journal-search');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-journal-filter]'));
  const stories = Array.from(document.querySelectorAll<HTMLElement>('[data-journal-story]'));
  const count = document.querySelector<HTMLElement>('#journal-visible-count');
  const empty = document.querySelector<HTMLElement>('#journal-no-results');

  const params = new URLSearchParams(window.location.search);
  let topic = params.get('topic') || '';
  if (!filters.some((button) => (button.dataset.journalFilter || '') === topic)) topic = '';
  if (search) search.value = params.get('q') || '';

  function applyFilters() {
    const term = (search?.value || '').toLocaleLowerCase().trim();
    let visible = 0;

    for (const story of stories) {
      const matches = (!topic || story.dataset.topic === topic)
        && (!term || (story.dataset.search || '').includes(term));
      story.hidden = !matches;
      if (matches) visible += 1;
    }
    for (const button of filters) {
      const active = (button.dataset.journalFilter || '') === topic;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    }

    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;

    const url = new URL(window.location.href);
    if (topic) url.searchParams.set('topic', topic);
    else url.searchParams.delete('topic');
    if (term) url.searchParams.set('q', term);
    else url.searchParams.delete('q');
    if (url.search !== window.location.search) window.history.replaceState(null, '', url.pathname + url.search + url.hash);
  }

  filters.forEach((button) => button.addEventListener('click', () => {
    topic = button.dataset.journalFilter || '';
    applyFilters();
  }));
  search?.addEventListener('input', applyFilters);
  document.querySelector('#journal-reset')?.addEventListener('click', () => { topic = ''; if (search) search.value = ''; applyFilters(); search?.focus(); });
  applyFilters();
  if (topic || search?.value) document.querySelector('#journal-notes')?.scrollIntoView({ block: 'start', behavior: 'auto' });
</script>

<style>
  .journal-hero{background:radial-gradient(circle at 84% 20%,#f4e2e5 0,transparent 37%),linear-gradient(115deg,#fff4eb 0%,#f9eee8 57%,#f5e8e8 100%);overflow:hidden}
  .journal-hero-inner{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(250px,.7fr);gap:clamp(34px,7vw,100px);align-items:center;padding-block:84px 91px}
  .journal-hero h1{font-size:clamp(48px,6.3vw,79px);line-height:1.08;letter-spacing:-.065em;max-width:730px;margin:22px 0 24px}
  .journal-hero h1 em,.journal-section-heading h2 em,.journal-make-copy h2 em,.journal-learn-invitation h2 em{color:var(--berry)}
  .journal-hero-copy>p{font-size:16px;line-height:1.85;color:#746563;max-width:555px;margin-bottom:26px}
