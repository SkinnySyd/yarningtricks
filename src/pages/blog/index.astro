---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const patterns = await getCollection('patterns', ({ data }) => !data.draft);
const lead = articles.find((article) => article.data.featured) ?? articles[0];
const more = articles.filter((article) => article.id !== lead?.id);
const selectedPatterns = ['sunflower-flower-pen', 'woodland-panda-amigurumi', 'seaside-seagull-amigurumi']
  .flatMap((id) => patterns.filter((pattern) => pattern.id === id));
const dateLabel = (value: Date) => value.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="The Journal — Crochet Stories, Tips & Little Joys" description="Pull up a chair at the Thread & Petal making table for original crochet tips, amigurumi finishing advice, flower inspiration, and thoughtful handmade gift ideas.">
  <header class="journal-hero">
    <div class="site-container journal-hero-inner">
      <div>
        <span class="eyebrow">✿ NOTES FROM THE MAKING TABLE</span>
        <h1>Welcome to <em>the journal.</em></h1>
        <p>A soft place for crochet stories, clever little tricks, and the lovely things that happen between the first loop and the last.</p>
        <a class="journal-hero-link" href="#latest-notes">Come on in <span aria-hidden="true">↘</span></a>
      </div>
      <div class="journal-hero-art" aria-hidden="true"><div class="journal-flower">✿</div><span>made slowly<br /><em>with love</em></span></div>
    </div>
  </header>

  {lead && (
    <section class="site-container journal-feature" aria-labelledby="journal-feature-title">
      <span class="eyebrow">A NOTE TO START WITH ✳</span>
      <article class="journal-feature-grid">
        <a class="journal-feature-image" href={'/blog/' + lead.id + '/'} aria-label={'Read ' + lead.data.title}>
          <img src={lead.data.image} alt={lead.data.imageAlt} width="780" height="900" fetchpriority="high" decoding="async" />
          <span aria-hidden="true">✿</span>
        </a>
        <div class="journal-feature-copy">
          <div class="journal-meta"><span>{lead.data.category}</span><span aria-hidden="true">·</span><span>{lead.data.readTime}</span></div>
          <h2 id="journal-feature-title"><a href={'/blog/' + lead.id + '/'}>{lead.data.title}</a></h2>
          <p>{lead.data.description}</p>
          <span class="journal-date">{dateLabel(lead.data.publishedDate)}</span>
          <a class="btn btn-primary" href={'/blog/' + lead.id + '/'}>Read the story <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </section>
  )}

  <section class="site-container journal-latest" id="latest-notes" aria-labelledby="journal-latest-title">
    <div class="journal-heading-row"><div><span class="eyebrow">FRESHLY TUCKED INTO THE BASKET</span><h2 id="journal-latest-title">More little <em>notes to love.</em></h2><p>Ideas for the making, the mending, and those finishing touches.</p></div><span class="journal-heading-flower" aria-hidden="true">✻</span></div>
    {more.length > 0 ? (
      <div class="journal-story-grid">
        {more.map((article) => (
          <article class="journal-story-card">
            <a class="journal-story-image" href={'/blog/' + article.id + '/'} aria-label={'Read ' + article.data.title}>
              <img src={article.data.image} alt={article.data.imageAlt} width="640" height="700" loading="lazy" decoding="async" />
              <span class="journal-card-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="journal-meta"><span>{article.data.category}</span><span aria-hidden="true">·</span><span>{article.data.readTime}</span></div>
            <h3><a href={'/blog/' + article.id + '/'}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
            <a class="journal-read-link" href={'/blog/' + article.id + '/'}>Read the note <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    ) : <p class="journal-empty">More notes are finding their way to the making table. Until then, enjoy our favorite patterns below.</p>}
  </section>

  <section class="journal-inspiration" aria-labelledby="journal-patterns-title">
    <div class="site-container">
      <div class="journal-heading-row"><div><span class="eyebrow">FROM THE PATTERN BASKET</span><h2 id="journal-patterns-title">In the mood to <em>make something?</em></h2><p>Pick up a hook and follow one of our free, step-by-step projects.</p></div><a class="journal-heading-action" href="/patterns/">All free patterns <span aria-hidden="true">↗</span></a></div>
      <div class="journal-pattern-grid">
        {selectedPatterns.map((pattern) => (
          <a class="journal-pattern-tile" href={'/patterns/' + pattern.id + '/'}>
            <img src={pattern.data.heroImage ?? pattern.data.image} alt={pattern.data.heroImageAlt ?? pattern.data.imageAlt} loading="lazy" decoding="async" width="440" height="470" />
            <span><small>{pattern.data.category} · {pattern.data.difficulty}</small><strong>{pattern.data.title}</strong><span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="site-container journal-last-note" aria-labelledby="journal-learn-title">
    <span class="journal-last-deco" aria-hidden="true">♡</span>
    <span class="eyebrow">A LITTLE HELP ALONG THE WAY</span>
    <h2 id="journal-learn-title">Every maker starts <em>somewhere.</em></h2>
    <p>Whether you are holding a hook for the very first time or looking up a stitch you haven't used in ages, the crochet school is always open.</p>
    <a class="btn btn-outline" href="/learn/">Visit the crochet school <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .journal-hero{overflow:hidden;background:radial-gradient(circle at 87% 20%,#f8d7d6 0,transparent 34%),linear-gradient(120deg,#fff1e7 0%,#f9ebe6 56%,#f5e3e8 100%)}
  .journal-hero-inner{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(240px,.9fr);gap:45px;align-items:center;padding-block:84px 82px}
  .journal-hero h1{font-size:clamp(49px,6vw,80px);line-height:1.09;letter-spacing:-.065em;margin:20px 0 22px}.journal-hero h1 em{color:var(--berry)}
  .journal-hero p{color:#735f60;font-size:17px;line-height:1.85;max-width:520px;margin:0 0 28px}
  .journal-hero-link{display:inline-flex;gap:13px;font-size:13px;color:var(--berry);font-weight:750;border-bottom:1px solid #b98a96;padding-bottom:8px}
  .journal-hero-art{height:305px;position:relative;display:grid;place-items:center}.journal-flower{font:300 305px/1 Georgia,serif;color:#d6a0ae;transform:rotate(-20deg);opacity:.67}
  .journal-hero-art>span{position:absolute;right:5%;bottom:8%;background:#fff9f2dc;border:1px solid #edd9d7;border-radius:100%;width:130px;height:130px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;font-size:12px;line-height:1.4;transform:rotate(12deg);color:#8b6270}.journal-hero-art>span em{font-size:22px}
  .journal-feature{padding-top:86px;padding-bottom:84px}.journal-feature>.eyebrow{display:block;margin-bottom:23px}
  .journal-feature-grid{display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:clamp(35px,6vw,100px)}
  .journal-feature-image{display:block;position:relative;border-radius:22px;overflow:hidden;background:#ecdcd4;aspect-ratio:1.05/1}
  .journal-feature-image img{width:100%;height:100%;object-fit:cover;transition:transform .3s}.journal-feature-image:hover img,.journal-story-image:hover img,.journal-pattern-tile:hover img{transform:scale(1.035)}
  .journal-feature-image>span{position:absolute;bottom:18px;left:22px;color:#fff9ed;font-size:48px;text-shadow:0 2px 8px #69434f5a}
  .journal-meta{display:flex;gap:9px;flex-wrap:wrap;align-items:center;font-size:11px;letter-spacing:.085em;text-transform:uppercase;color:#956777;font-weight:750}
  .journal-feature-copy h2{font:500 clamp(35px,4.25vw,59px)/1.14 Georgia,serif;letter-spacing:-.05em;margin:19px 0 22px}
  .journal-feature-copy h2 a:hover,.journal-story-card h3 a:hover{color:var(--berry)}
  .journal-feature-copy p{line-height:1.85;color:var(--muted);max-width:480px;margin-bottom:17px}.journal-date{display:block;font-size:12px;color:#998781;margin-bottom:25px}
  .journal-latest{padding-block:20px 105px;scroll-margin-top:20px}
  .journal-heading-row{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:35px}
  .journal-heading-row h2{font-size:clamp(34px,4vw,53px);line-height:1.18;margin:12px 0 10px}
  .journal-heading-row h2 em,.journal-last-note h2 em{color:var(--berry)}
  .journal-heading-row p{color:var(--muted);line-height:1.7;font-size:14px;margin:0}.journal-heading-flower{font-size:80px;color:#dba8ac;line-height:1}
  .journal-story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}
  .journal-story-card{display:flex;flex-direction:column;min-width:0}
  .journal-story-image{display:block;position:relative;overflow:hidden;border-radius:15px;background:#f4e7e2;aspect-ratio:1.07/1;margin-bottom:20px}
  .journal-story-image img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
  .journal-card-arrow{position:absolute;top:15px;right:15px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#fffaf4e8;color:var(--berry)}
  .journal-story-card h3{font:500 27px/1.24 Georgia,serif;letter-spacing:-.045em;margin:14px 0 12px}
  .journal-story-card p{font-size:14px;line-height:1.72;color:var(--muted);margin-bottom:18px;flex:1}
  .journal-read-link{display:inline-flex;gap:9px;align-items:center;align-self:start;color:var(--berry);font-size:13px;font-weight:750;padding-bottom:4px;border-bottom:1px solid #d8a8b6}
  .journal-empty{color:var(--muted);line-height:1.7}
  .journal-inspiration{background:#f4eee8;padding:80px 0 90px}.journal-heading-action{white-space:nowrap;font-size:13px;font-weight:750;color:var(--berry);border-bottom:1px solid #d3a7b0;padding-bottom:6px}
  .journal-pattern-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}
  .journal-pattern-tile{position:relative;overflow:hidden;border-radius:16px;background:#fffaf4}
  .journal-pattern-tile img{height:275px;width:100%;object-fit:cover;transition:transform .3s}
  .journal-pattern-tile>span{display:grid;grid-template-columns:1fr auto;gap:9px;padding:18px 20px 21px}
  .journal-pattern-tile small{grid-column:1/-1;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#9a7380;font-weight:750}
  .journal-pattern-tile strong{font:500 22px/1.25 Georgia,serif;letter-spacing:-.025em}.journal-pattern-tile>span>span{color:var(--berry);font-size:19px}
  .journal-last-note{text-align:center;position:relative;padding-block:100px 116px;max-width:780px}
  .journal-last-note .eyebrow{position:relative;z-index:1}.journal-last-note h2{font-size:clamp(34px,4.4vw,57px);line-height:1.16;margin:18px 0}
  .journal-last-note p{color:var(--muted);line-height:1.85;margin:0 auto 24px;max-width:530px}
  .journal-last-deco{position:absolute;font-size:190px;color:#f2dfe2;line-height:1;right:1%;top:5%;z-index:0;pointer-events:none}
  @media(max-width:850px){.journal-hero-inner{grid-template-columns:1fr .55fr;gap:12px}.journal-hero-art{height:270px}.journal-flower{font-size:230px}.journal-story-grid{gap:18px}.journal-story-card h3{font-size:23px}.journal-feature-grid{gap:35px}.journal-pattern-tile img{height:230px}}
  @media(max-width:650px){.journal-hero-inner{display:block;padding-block:65px 59px}.journal-hero-art{display:none}.journal-hero h1{font-size:clamp(44px,12vw,65px)}.journal-hero p{font-size:15px}.journal-feature{padding-block:62px}.journal-feature-grid{grid-template-columns:1fr;gap:27px}.journal-feature-copy h2{font-size:36px}.journal-latest{padding-bottom:70px}.journal-story-grid{grid-template-columns:1fr;gap:44px}.journal-story-image{aspect-ratio:1.24/1}.journal-story-card h3{font-size:26px}.journal-heading-flower{display:none}.journal-heading-row{align-items:start;flex-direction:column}.journal-inspiration{padding-block:65px}.journal-pattern-grid{grid-template-columns:1fr;gap:18px}.journal-pattern-tile{display:grid;grid-template-columns:125px 1fr;min-height:140px}.journal-pattern-tile img{height:100%;min-height:145px}.journal-pattern-tile>span{align-content:center;padding:15px;gap:6px}.journal-pattern-tile strong{font-size:19px}.journal-last-note{padding-block:78px 90px}}
  @media(max-width:385px){.journal-pattern-tile{grid-template-columns:100px 1fr}.journal-pattern-tile strong{font-size:17px}}
  @media(prefers-reduced-motion:reduce){.journal-feature-image img,.journal-story-image img,.journal-pattern-tile img{transition:none}}
</style>