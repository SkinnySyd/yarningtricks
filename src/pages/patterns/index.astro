---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternCard from '../../components/PatternCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('patterns', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());

const paths = [
  {
    id: 'beginner',
    ordinal: '01',
    name: 'First Little Stitches',
    description: 'The happiest place to begin.',
    invitation: 'A little chain, a little confidence, a whole lot of possibility.',
    difficulty: ['Beginner'],
    covers: ['granny-square-coaster', 'simple-yarn-bookmark'],
    icon: '✳',
  },
  {
    id: 'easy',
    ordinal: '02',
    name: 'Little Joys',
    description: 'Small adventures, lovely rewards.',
    invitation: 'Friendly makes for when your stitches feel like old friends.',
    difficulty: ['Easy'],
    covers: ['seaside-seagull-amigurumi', 'woodland-panda-amigurumi'],
    icon: '✿',
  },
  {
    id: 'intermediate',
    ordinal: '03',
    name: 'Growing Confidence',
    description: 'A few more petals to unfold.',
    invitation: 'Interesting shapes and little details to enjoy at your pace.',
    difficulty: ['Intermediate'],
    covers: ['puddlewick-mallard-amigurumi', 'bracken-atlantic-puffin-amigurumi'],
    icon: '❀',
  },
  {
    id: 'advanced',
    ordinal: '04',
    name: 'Wildflower Adventures',
    description: 'Something wonderful to master.',
    invitation: 'For makers who love a rewarding challenge, stitch by stitch.',
    difficulty: ['Advanced', 'Hard'],
    covers: ['mallow-woolly-mammoth-amigurumi', 'heather-highland-cow-amigurumi'],
    icon: '✾',
  },
].map((path) => ({
  ...path,
  count: posts.filter((post) => path.difficulty.includes(post.data.difficulty)).length,
  photos: path.covers.map((slug) => posts.find((post) => post.id === slug))
    .filter((post) => post !== undefined),
}));
---
<BaseLayout title="Free crochet patterns" description="Find a crochet pattern that feels just right. Follow a beginner-friendly stitch garden path, browse by category, or discover a surprise project.">
  <section class="page-heading page-heading-pink garden-hero">
    <div class="site-container garden-hero-inner">
      <div>
        <span class="eyebrow">THE THREAD & PETAL PATTERN LIBRARY</span>
        <h1>Find your next <em>happy project.</em></h1>
        <p>Every handmade treasure begins with one little stitch. Take a wander through our pattern garden and find something lovely to make.</p>
        <a class="garden-hero-link" href="#project-basket">Browse all {posts.length} patterns <span aria-hidden="true">↗</span></a>
      </div>
      <div class="garden-hero-doodle" aria-hidden="true">
        <svg viewBox="0 0 290 190" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19 165C50 128 72 174 96 129C117 90 146 138 169 94C189 54 209 85 249 32" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="5 10"/>
          <path d="M181 91C167 71 176 59 189 57C197 73 193 84 181 91ZM204 74C214 50 229 49 240 58C232 76 217 80 204 74ZM91 128C70 115 69 98 82 91C100 98 102 113 91 128Z" fill="#B7C9AC"/>
          <circle cx="249" cy="30" r="15" fill="#E6B7B4"/>
          <path d="M249 4V56M223 30H275M230 11L268 49M268 11L230 49" stroke="#A85E74" stroke-width="3" stroke-linecap="round"/>
          <circle cx="249" cy="30" r="6" fill="#FFF7F0"/>
          <path d="M12 166C18 155 29 155 32 169C20 178 14 174 12 166Z" fill="#E9C69F"/>
        </svg>
        <span>one stitch at a time</span>
      </div>
    </div>
  </section>

  <section class="site-container stitch-garden" aria-labelledby="garden-title">
    <div class="garden-intro">
      <div>
        <span class="eyebrow">A LITTLE WAY TO FIND YOUR WAY</span>
        <h2 id="garden-title">Choose your <em>crochet adventure.</em></h2>
        <p>Some days call for a simple square. Other days, a wonderfully woolly challenge. Choose what feels right today.</p>
      </div>
      <span class="garden-intro-note"><span aria-hidden="true">✳</span> There's no wrong path here.</span>
    </div>

    <div class="garden-paths" role="group" aria-label="Filter patterns by crochet difficulty">
      <svg class="garden-connecting-thread" viewBox="0 0 1100 140" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 90C150 10 215 118 338 52S574 105 683 48S906 110 1100 42" fill="none" stroke="#D7B0AF" stroke-width="3" stroke-dasharray="5 12" stroke-linecap="round"/>
      </svg>
      {paths.map((path) => (
        <button type="button" class:list={['garden-path', `garden-path--${path.id}`]} data-garden-path={path.id} aria-pressed="false" aria-controls="pattern-list" aria-label={`${path.name}: ${path.count} patterns`}>
          <span class="garden-path-top"><span>{path.ordinal} <span aria-hidden="true">/ 04</span></span><span class="garden-path-flower" aria-hidden="true">{path.icon}</span></span>
          <span class="garden-path-images" aria-hidden="true">
            {path.photos.map((post, index) => (
              <img src={post.data.image} alt="" loading="lazy" decoding="async" width="170" height="180" class:list={['garden-path-photo', { 'second-photo': index === 1 }]} />
            ))}
          </span>
          <span class="garden-path-content">
            <span class="garden-path-name">{path.name}</span>
            <span class="garden-path-description">{path.description}</span>
            <span class="garden-path-footer"><span>{path.count} {path.count === 1 ? 'pattern' : 'patterns'}</span><span aria-hidden="true">Explore ↗</span></span>
          </span>
        </button>
      ))}
    </div>

    <div class="garden-afterpaths">
      <div class="garden-current"><span aria-hidden="true">❧</span> <strong id="garden-selection-label">All paths are open</strong><span id="garden-selection-detail"> — wander through the whole collection below.</span></div>
      <button class="garden-all-button" id="garden-show-all" type="button" aria-pressed="true" aria-controls="pattern-list">View every pattern <span aria-hidden="true">↗</span></button>
    </div>
  </section>

  <section id="project-basket" class="site-container listing-section garden-listing" aria-labelledby="basket-title">
    <div class="garden-basket-heading">
      <div>
        <span class="eyebrow">THE PROJECT BASKET</span>
        <h2 id="basket-title">A little something <em>to make.</em></h2>
      </div>
      <p>Use the little tools below to find your next handmade favorite.</p>
    </div>

    <div class="garden-toolbar" role="search" aria-label="Find crochet patterns">
      <div class="garden-search-field">
        <label for="pattern-search">Search the basket</label>
        <div class="garden-search-wrap"><span aria-hidden="true">⌕</span><input type="search" id="pattern-search" placeholder="A bird, a flower, a stitch…" autocomplete="off" /></div>
      </div>
      <div class="garden-select-field">
        <label for="category-filter">Category</label>
        <select id="category-filter">
          <option value="">All categories</option>
          <option value="stitch guides">Stitch guides</option>
          <option value="home & decor">Home & decor</option>
          <option value="accessories">Accessories</option>
          <option value="amigurumi">Amigurumi</option>
        </select>
      </div>
      <div class="garden-select-field">
        <label for="sort-patterns">Sort by</label>
        <select id="sort-patterns">
          <option value="newest">Newest first</option>
          <option value="easiest">Easiest first</option>
          <option value="hardest">Most challenging</option>
          <option value="az">A to Z</option>
        </select>
      </div>
      <button type="button" class="garden-surprise-button" id="garden-surprise" aria-controls="garden-reveal">
        <span aria-hidden="true">✧</span> Surprise me
      </button>
    </div>

    <div id="garden-reveal" class="garden-reveal" hidden tabindex="-1" aria-live="polite">
      <img id="garden-reveal-image" src="/images/social-cover.png" alt="" width="180" height="210" loading="lazy" />
      <div>
        <span class="eyebrow">A LITTLE SURPRISE FROM THE BASKET</span>
        <h3 id="garden-reveal-title">Your next project awaits</h3>
        <p id="garden-reveal-description"></p>
        <a id="garden-reveal-link" href="#project-basket">See this pattern <span aria-hidden="true">↗</span></a>
      </div>
      <button type="button" id="garden-reveal-close" class="garden-reveal-close" aria-label="Close surprise">×</button>
    </div>

    <div class="garden-result-summary">
      <p aria-live="polite" aria-atomic="true"><span id="visible-count">{posts.length}</span> lovely {posts.length === 1 ? 'project' : 'projects'} to explore <span aria-hidden="true">✳</span></p>
      <button id="garden-reset" type="button">Clear filters <span aria-hidden="true">×</span></button>
    </div>
    <div id="pattern-list" class="cards-grid listing-grid garden-results">{posts.map((post) => <PatternCard post={post} />)}</div>
    <div id="no-results" class="garden-empty" hidden>
      <span aria-hidden="true">❀</span>
      <h3>Nothing in the basket just yet.</h3>
      <p>Try another stitch, choose a different garden path, or look through all our projects.</p>
      <button type="button" id="garden-empty-reset">Show all patterns</button>
    </div>
  </section>

  <script>
    type Level = 'all' | 'beginner' | 'easy' | 'intermediate' | 'advanced';
    type Order = 'newest' | 'easiest' | 'hardest' | 'az';
    const search = document.querySelector<HTMLInputElement>('#pattern-search');
    const category = document.querySelector<HTMLSelectElement>('#category-filter');
    const sort = document.querySelector<HTMLSelectElement>('#sort-patterns');
    const list = document.querySelector<HTMLElement>('#pattern-list');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#pattern-list [data-filter-card]'));
    const cardIndices = new Map(cards.map((card, index) => [card, index]));
    const count = document.querySelector<HTMLElement>('#visible-count');
    const noResults = document.querySelector<HTMLElement>('#no-results');
    const reset = document.querySelector<HTMLButtonElement>('#garden-reset');
    const pathButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-garden-path]'));
    const showAll = document.querySelector<HTMLButtonElement>('#garden-show-all');
    const selectionLabel = document.querySelector<HTMLElement>('#garden-selection-label');
    const selectionDetail = document.querySelector<HTMLElement>('#garden-selection-detail');
    const reveal = document.querySelector<HTMLElement>('#garden-reveal');
    const revealImage = document.querySelector<HTMLImageElement>('#garden-reveal-image');
    const revealTitle = document.querySelector<HTMLElement>('#garden-reveal-title');
    const revealDescription = document.querySelector<HTMLElement>('#garden-reveal-description');
    const revealLink = document.querySelector<HTMLAnchorElement>('#garden-reveal-link');
    const surpriseButton = document.querySelector<HTMLButtonElement>('#garden-surprise');
    const levelValues: Level[] = ['all', 'beginner', 'easy', 'intermediate', 'advanced'];
    const orderValues: Order[] = ['newest', 'easiest', 'hardest', 'az'];
    const rank: Record<string, number> = { beginner: 0, easy: 1, intermediate: 2, advanced: 3, hard: 4 };
    const labels: Record<Level, [string, string]> = {
      all: ['All paths are open', ' — wander through the whole collection below.'],
      beginner: ['First Little Stitches', ' — slow, gentle, lovely beginnings.'],
      easy: ['Little Joys', ' — cheerful makes without the fuss.'],
      intermediate: ['Growing Confidence', ' — a few extra details to try.'],
      advanced: ['Wildflower Adventures', ' — a challenge worth taking your time over.'],
    };
    const query = new URLSearchParams(window.location.search);
    const requestedLevel = (query.get('level') || 'all').toLowerCase() as Level;
    let level: Level = levelValues.includes(requestedLevel) ? requestedLevel : 'all';
    const requestedSort = (query.get('sort') || 'newest').toLowerCase() as Order;
    if (sort) sort.value = orderValues.includes(requestedSort) ? requestedSort : 'newest';
    if (category && Array.from(category.options).some((option) => option.value === (query.get('category') || '').toLowerCase())) {
      category.value = (query.get('category') || '').toLowerCase();
    }
    if (search && query.has('q')) search.value = query.get('q') || '';

    const matchesLevel = (difficulty: string) => level === 'all' ||
      (level === 'advanced' ? difficulty === 'advanced' || difficulty === 'hard' : difficulty === level);
    const sortedCards = (order: Order) => [...cards].sort((left, right) => {
      if (order === 'az') return (left.dataset.sortTitle || '').localeCompare(right.dataset.sortTitle || '');
      if (order === 'easiest' || order === 'hardest') {
        const delta = (rank[left.dataset.difficulty || ''] ?? 9) - (rank[right.dataset.difficulty || ''] ?? 9);
        if (delta) return order === 'easiest' ? delta : -delta;
      }
      return Number(right.dataset.published || 0) - Number(left.dataset.published || 0) ||
        (cardIndices.get(left) || 0) - (cardIndices.get(right) || 0);
    });
    const closeReveal = () => { if (reveal) reveal.hidden = true; };
    function applyFilters() {
      const term = (search?.value || '').toLocaleLowerCase().trim();
      const currentCategory = category?.value || '';
      let shown = 0;
      const order = (sort?.value || 'newest') as Order;
      if (list) list.append(...sortedCards(order));
      for (const card of cards) {
        const match = matchesLevel(card.dataset.difficulty || '') &&
          (!currentCategory || card.dataset.category === currentCategory) &&
          (!term || (card.dataset.keywords || '').includes(term));
        card.hidden = !match;
        if (match) shown += 1;
      }
      if (count) count.textContent = String(shown);
      if (noResults) noResults.hidden = shown !== 0;
      if (surpriseButton) surpriseButton.disabled = shown === 0;
      for (const button of pathButtons) button.setAttribute('aria-pressed', String(button.dataset.gardenPath === level));
      showAll?.setAttribute('aria-pressed', String(level === 'all'));
      if (selectionLabel) selectionLabel.textContent = labels[level][0];
      if (selectionDetail) selectionDetail.textContent = labels[level][1];
      if (reset) reset.hidden = level === 'all' && !term && !currentCategory && order === 'newest';
      const url = new URL(window.location.href);
      for (const key of ['q', 'category', 'level', 'sort']) url.searchParams.delete(key);
      if (term) url.searchParams.set('q', search?.value.trim() || '');
      if (currentCategory) url.searchParams.set('category', currentCategory);
      if (level !== 'all') url.searchParams.set('level', level);
      if (order !== 'newest') url.searchParams.set('sort', order);
      window.history.replaceState(null, '', url.pathname + url.search + url.hash);
      closeReveal();
    }
    function resetAll() {
      level = 'all';
      if (search) search.value = '';
      if (category) category.value = '';
      if (sort) sort.value = 'newest';
      applyFilters();
    }
    for (const button of pathButtons) button.addEventListener('click', () => {
      const selection = button.dataset.gardenPath as Level;
      level = level === selection ? 'all' : selection;
      applyFilters();
    });
    showAll?.addEventListener('click', () => { level = 'all'; applyFilters(); });
    search?.addEventListener('input', applyFilters);
    category?.addEventListener('change', applyFilters);
    sort?.addEventListener('change', applyFilters);
    reset?.addEventListener('click', resetAll);
    document.querySelector('#garden-empty-reset')?.addEventListener('click', resetAll);
    document.querySelector('#garden-reveal-close')?.addEventListener('click', closeReveal);
    surpriseButton?.addEventListener('click', () => {
      const eligible = cards.filter((card) => !card.hidden);
      if (!eligible.length || !reveal || !revealTitle || !revealDescription || !revealLink || !revealImage) return;
      const picked = eligible[Math.floor(Math.random() * eligible.length)];
      const name = picked.querySelector('h3')?.textContent?.trim() || 'A lovely project';
      const description = picked.querySelector(':scope > p')?.textContent?.trim() || 'A little something lovely to crochet.';
      const link = picked.querySelector<HTMLAnchorElement>('.pattern-thumb-link');
      const photo = picked.querySelector<HTMLImageElement>('.pattern-thumb');
      revealTitle.textContent = name;
      revealDescription.textContent = description;
      revealLink.href = link?.href || '#project-basket';
      revealImage.src = photo?.src || '/images/social-cover.png';
      revealImage.alt = photo?.alt || name;
      reveal.hidden = false;
      reveal.focus({ preventScroll: true });
    });
    applyFilters();
  </script>
</BaseLayout>

<style>
  .garden-hero{overflow:hidden;position:relative;padding-block:69px 75px}
  .garden-hero-inner{display:flex;align-items:center;justify-content:space-between;gap:34px}
  .garden-hero-inner>div:first-child{max-width:720px;position:relative;z-index:1}
  .garden-hero h1{max-width:680px}
  .garden-hero p{max-width:590px}
  .garden-hero-link{display:inline-flex;gap:13px;align-items:center;font-size:13px;font-weight:700;color:var(--berry);border-bottom:1px solid currentColor;padding:8px 0;margin-top:21px}
  .garden-hero-link span{font-size:18px;transition:transform .2s}
  .garden-hero-link:hover span{transform:translate(3px,-3px)}
  .garden-hero-doodle{width:270px;max-width:30%;flex:0 0 270px;color:#c89299;transform:rotate(-9deg);opacity:.95;position:relative}
  .garden-hero-doodle span{display:block;font-family:Georgia,serif;font-style:italic;font-size:18px;color:#a77783;transform:rotate(9deg);text-align:center;margin-top:-2px}
  .stitch-garden{padding-top:86px;padding-bottom:62px}
  .garden-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:31px}
  .garden-intro h2,.garden-basket-heading h2{font-family:Georgia,serif;font-weight:500;letter-spacing:-.055em;font-size:clamp(35px,4.2vw,54px);line-height:1.12;margin:11px 0 12px}
  .garden-intro h2 em,.garden-basket-heading h2 em{font-weight:400;color:var(--berry)}
  .garden-intro p{font-size:14px;line-height:1.75;color:var(--muted);max-width:600px;margin:0}
  .garden-intro-note{color:#9d7883;font-family:Georgia,serif;font-style:italic;font-size:14px;white-space:nowrap;padding-bottom:4px}
  .garden-intro-note span{font-style:normal;color:#b68494;margin-right:7px}
  .garden-paths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;position:relative;isolation:isolate}
  .garden-connecting-thread{position:absolute;z-index:-1;top:26%;left:0;width:100%;height:130px;pointer-events:none;opacity:.8}
  .garden-path{font:inherit;color:var(--ink);text-align:left;cursor:pointer;border:1px solid #e3d1ca;border-radius:19px;min-width:0;padding:16px 16px 15px;display:flex;flex-direction:column;min-height:340px;overflow:hidden;position:relative;background:#f4e4df;box-shadow:0 7px 18px #82665d08;transition:transform .2s,border-color .2s,box-shadow .2s}
  .garden-path:hover{transform:translateY(-5px);box-shadow:0 15px 28px #82665d1c}
  .garden-path:focus-visible{outline:3px solid var(--berry);outline-offset:3px}
  .garden-path[aria-pressed="true"]{border-color:#a15e74;box-shadow:0 0 0 2px #a15e7440,0 14px 30px #82665d1a}
  .garden-path--beginner{background:linear-gradient(158deg,#eef3e8,#f6e9de 88%)}
  .garden-path--easy{background:linear-gradient(158deg,#fae4df,#f9efe5 88%)}
  .garden-path--intermediate{background:linear-gradient(158deg,#eee7f1,#f7e7e4 88%)}
  .garden-path--advanced{background:linear-gradient(158deg,#f4e9cf,#fae6de 88%)}
  .garden-path-top{display:flex;align-items:flex-start;justify-content:space-between;gap:6px;position:relative;z-index:2;font-size:10px;font-weight:750;letter-spacing:.13em;color:#917382}
  .garden-path-top>span:first-child>span{opacity:.7}
  .garden-path-flower{font-size:27px;line-height:1;color:#b47786;transition:transform .3s}
  .garden-path[aria-pressed="true"] .garden-path-flower{transform:rotate(25deg) scale(1.16);color:#8f4965}
  .garden-path-images{display:block;height:157px;position:relative;margin:0 4px 4px}
  .garden-path-photo{position:absolute;width:125px;height:143px;left:calc(50% - 82px);top:4px;object-fit:cover;border:4px solid #fffaf4;border-radius:84px 84px 60px 60px;box-shadow:0 8px 15px #7b615228;transform:rotate(-12deg);transition:transform .35s}
  .garden-path-photo.second-photo{left:calc(50% - 4px);width:95px;height:114px;top:26px;transform:rotate(13deg);z-index:1}
  .garden-path:hover .garden-path-photo:first-child{transform:rotate(-16deg) translate(-4px,-3px)}
  .garden-path:hover .garden-path-photo.second-photo{transform:rotate(18deg) translate(4px,-3px)}
  .garden-path-content{display:flex;flex-direction:column;gap:5px;margin-top:auto;position:relative;z-index:2}
  .garden-path-name{font-family:Georgia,serif;font-size:23px;line-height:1.08;letter-spacing:-.045em;min-height:50px}
  .garden-path-description{font-size:12px;line-height:1.5;color:#806f6e;min-height:36px}
  .garden-path-footer{display:flex;justify-content:space-between;align-items:center;gap:5px;margin-top:12px;border-top:1px solid #ae8e8838;padding-top:11px;color:#8c5269;font-size:11px;font-weight:700}
  .garden-path-footer span:last-child{white-space:nowrap}
  .garden-afterpaths{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:25px;background:#f6efe7;border:1px solid #ece1d7;border-radius:15px;padding:15px 20px}
  .garden-current{font-size:13px;line-height:1.6;color:#776967}
  .garden-current>span:first-child{font-size:20px;color:#a4768b;margin-right:7px;vertical-align:middle}
  .garden-current strong{color:#5a434b;font-weight:700}
  .garden-all-button{border:0;background:transparent;white-space:nowrap;color:var(--berry);font-size:12px;font-weight:750;cursor:pointer;padding:7px 1px}
  .garden-all-button:hover{text-decoration:underline}
  .garden-all-button[aria-pressed="true"]{text-decoration:underline;text-underline-offset:5px}
  .garden-listing{padding-top:24px}
  .garden-basket-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:25px}
  .garden-basket-heading>p{font-size:13px;line-height:1.6;color:var(--muted);max-width:270px;margin-bottom:10px}
  .garden-toolbar{border:1px solid #ead8d2;background:#fffbf7;box-shadow:0 4px 20px #745e5510;border-radius:20px;padding:19px;display:grid;grid-template-columns:minmax(200px,1.6fr) minmax(160px,1fr) minmax(150px,1fr) auto;gap:13px;align-items:end}
  .garden-search-field,.garden-select-field{display:flex;flex-direction:column;gap:8px;min-width:0}
  .garden-search-field label,.garden-select-field label{font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#83646b}
  .garden-search-wrap{position:relative}
  .garden-search-wrap span{position:absolute;left:15px;top:6px;font-size:27px;color:#a18487;pointer-events:none}
  .garden-search-wrap input,.garden-select-field select{background:white;border:1px solid #e3d4cb;border-radius:11px;color:var(--ink);font-size:13px;height:47px;width:100%;min-width:0}
  .garden-search-wrap input{padding:0 13px 0 42px}
