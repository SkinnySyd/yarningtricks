---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { siteConfig } from '../site-config';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}
const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '/images/social-cover.png',
  type = 'website',
  publishedTime,
} = Astro.props;
const fullTitle = title === siteConfig.name ? `${siteConfig.name} — ${siteConfig.tagline}` : `${title} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const absoluteImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
// Site ownership verification is independent of ad serving. A certified
// advertising CMP must be configured before advertisements can be enabled.
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || '';
const requestedVerificationId = import.meta.env.PUBLIC_ADSENSE_VERIFICATION_ID || 'ca-pub-8740522165725934';
const adsenseVerificationId = /^ca-pub-[0-9]{16}$/.test(requestedVerificationId) ? requestedVerificationId : '';
// Consent-message delivery uses the AdSense publisher tag, but should not
// automatically turn on when the message is still a draft.
// Check that Auto ads are OFF in AdSense before enabling this flag.
const cmpOn = import.meta.env.PUBLIC_ENABLE_GOOGLE_CMP === 'true';
const adsOn = import.meta.env.PUBLIC_ENABLE_ADS === 'true' &&
  import.meta.env.PUBLIC_ADSENSE_CMP_READY === 'true' &&
  /^ca-pub-[0-9]{16}$/.test(adClient);
const publisherId = adsenseVerificationId || adClient;
const publisherScriptOn = (cmpOn || adsOn) && /^ca-pub-[0-9]{16}$/.test(publisherId);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#fffaf4" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {adsenseVerificationId && <meta name="google-adsense-account" content={adsenseVerificationId} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={siteConfig.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absoluteImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {publisherScriptOn && <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${publisherId}`}></script>}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header />
  <main id="main-content"><slot /></main>
  <Footer />
  <CookieConsent />
</body>
</html>
